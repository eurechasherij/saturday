# Copy to backend/.env and fill in only what you need.
# Defaults work out of the box if Ollama is running locally.

# ---- Provider selection ----
# SATURDAY_DEFAULT_PROVIDER=ollama
# SATURDAY_DEFAULT_MODEL=qwen2.5:7b-instruct

# ---- Ollama (default, free, local) ----
# SATURDAY_OLLAMA_HOST=http://localhost:11434

# ---- OpenAI (optional fallback) ----
# SATURDAY_OPENAI_API_KEY=sk-...

# ---- Anthropic (optional fallback) ----
# SATURDAY_ANTHROPIC_API_KEY=sk-ant-...
