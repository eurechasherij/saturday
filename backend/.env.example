# Copy to backend/.env and fill in only what you need.
# Defaults work out of the box if Ollama is running locally.

# ---- Provider selection ----
# SATURDAY_DEFAULT_PROVIDER=ollama
# SATURDAY_DEFAULT_MODEL=qwen2.5:7b-instruct

# ---- Ollama (default, free, local) ----
# SATURDAY_OLLAMA_HOST=http://localhost:11434

# ---- OpenAI (optional fallback) ----
# SATURDAY_OPENAI_API_KEY=sk-...

# ---- Anthropic (optional fallback) ----
# SATURDAY_ANTHROPIC_API_KEY=sk-ant-...

# ---- Groq (free tier — https://console.groq.com) ----
# Best free option: GPT OSS 20B (1000 tok/s) or 120B (500 tok/s)
# SATURDAY_DEFAULT_PROVIDER=groq
# SATURDAY_DEFAULT_MODEL=openai/gpt-oss-20b   # fastest
# SATURDAY_DEFAULT_MODEL=openai/gpt-oss-120b  # best quality
# SATURDAY_GROQ_API_KEY=gsk_...

# ---- Google Gemini (free tier — https://aistudio.google.com) ----
# 1,500 req/day free, 1M token context window
# SATURDAY_DEFAULT_PROVIDER=gemini
# SATURDAY_DEFAULT_MODEL=gemini-2.0-flash
# SATURDAY_GEMINI_API_KEY=AIza...
